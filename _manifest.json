{
  "manifest_version": 2,
  "id": "github.FleetingEternity-qyt.qq-like",
  "version": "1.0.4",
  "name": "QQ 名片点赞",
  "description": "支持 OneBot v11 的 QQ 名片点赞插件，兼容旧版 NapCat、SnowLuma 适配器，支持命令、口语和每日定时点赞",
  "author": {
    "name": "FleetingEternity-qyt",
    "url": "https://github.com/FleetingEternity-qyt"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/FleetingEternity-qyt/maibot-qq-like",
    "homepage": "https://github.com/FleetingEternity-qyt/maibot-qq-like",
    "documentation": "https://github.com/FleetingEternity-qyt/maibot-qq-like/blob/main/README.md",
    "issues": "https://github.com/FleetingEternity-qyt/maibot-qq-like/issues"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.7.1",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "api.call",
    "api.get",
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "tool",
  "changelog": "CHANGELOG.md",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "package",
      "background": "#f6f1e8"
    }
  }
}
